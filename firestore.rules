rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to verify if the caller is the legitimate owner
    // Supports direct UID match or forwarded identity via uid_mappings
    function isOwner(uid) {
      return request.auth != null && (
        request.auth.uid == uid ||
        (
          uid != null && uid != '' &&
          exists(/databases/$(database)/documents/uid_mappings/$(uid)) &&
          get(/databases/$(database)/documents/uid_mappings/$(uid)).data.get('activeUid', '') == request.auth.uid
        )
      );
    }

    // Strict Single-Guardian check: verified guardian registered on the ward's policy document
    // Supports direct UID match or forwarded identity via uid_mappings
    function isGuardianOf(wardUid) {
      return request.auth != null && (
        exists(/databases/$(database)/documents/policies/$(wardUid)) && (
          get(/databases/$(database)/documents/policies/$(wardUid)).data.get('guardianUid', null) == request.auth.uid ||
          (
            get(/databases/$(database)/documents/policies/$(wardUid)).data.get('guardianUid', '') != '' &&
            exists(/databases/$(database)/documents/uid_mappings/$(get(/databases/$(database)/documents/policies/$(wardUid)).data.get('guardianUid', ''))) &&
            get(/databases/$(database)/documents/uid_mappings/$(get(/databases/$(database)/documents/policies/$(wardUid)).data.get('guardianUid', ''))).data.get('activeUid', '') == request.auth.uid
          )
        )
      );
    }

    // Verifies if ward is unsupervised (no policy doc yet or no guardian claimed)
    function isUnsupervisedOwner(wardUid) {
      return !exists(/databases/$(database)/documents/policies/$(wardUid)) ||
        get(/databases/$(database)/documents/policies/$(wardUid)).data.get('guardianUid', null) == null;
    }

    // Verifies if ward is allowed to make self-control app decisions (approve or reject)
    function isSelfAppDecisionAllowed(wardUid) {
      return isUnsupervisedOwner(wardUid) || (
        exists(/databases/$(database)/documents/policies/$(wardUid)) &&
        get(/databases/$(database)/documents/policies/$(wardUid)).data.get('isSelfControlAllowed', false) == true &&
        (
          get(/databases/$(database)/documents/policies/$(wardUid)).data.get('selfControlNewAppsAllowed', false) == true ||
          get(/databases/$(database)/documents/policies/$(wardUid)).data.get('selfControlAppsAllowed', false) == true
        )
      );
    }

    // Helper using let binding to verify packageId is not in customBlacklistPackages (only called when policy doc exists)
    function isPackageNotBlacklistedInPolicy(wardUid, packageId) {
      let blacklist = get(/databases/$(database)/documents/policies/$(wardUid)).data.get('customBlacklistPackages', []);
      return !(blacklist is list && packageId in blacklist);
    }

    // Verifies if ward is legitimately allowed to self-approve an application via QR or App Management
    function isSelfAppApprovalAllowed(wardUid, packageId) {
      return isSelfAppDecisionAllowed(wardUid) && (
        !exists(/databases/$(database)/documents/policies/$(wardUid)) ||
        isPackageNotBlacklistedInPolicy(wardUid, packageId)
      );
    }

    // 1. Pairings: Exchange and resolve 6-character alphanumeric pairing codes (with 15-min expiration & one-time use)
    match /pairings/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.get('used', false) == false &&
        request.resource.data.get('status', '') in ['PENDING', 'ACTIVE'] &&
        (
          !('expiresAt' in request.resource.data) ||
          (
            request.resource.data.expiresAt > request.time.toMillis() &&
            request.resource.data.expiresAt <= request.time.toMillis() + 960000
          )
        );
      allow update: if request.auth != null && (
        (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid) ||
        (
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.status == 'LOCKED' &&
          request.resource.data.used == true &&
          request.resource.data.pairedGuardianUid == request.auth.uid &&
          resource.data.get('used', false) == false &&
          resource.data.get('status', '') in ['PENDING', 'ACTIVE'] &&
          (
            !('expiresAt' in resource.data) ||
            resource.data.expiresAt >= request.time.toMillis()
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'used', 'pairedGuardianUid'])
        )
      );
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isGuardianOf(resource.data.ownerUid));
    }

    // 2. Policies: Unified protection policies with strict single-guardian lock, heartbeat & 24h emergency breakout
    match /policies/{wardUid} {
      allow read: if isOwner(wardUid) || isGuardianOf(wardUid);
      allow create: if isOwner(wardUid);
      allow update: if request.auth != null && (
        // Case 1: Guardian updates or revokes
        isGuardianOf(wardUid) ||
        (resource.data.get('guardianUid', null) != null && resource.data.get('guardianUid', null) == request.auth.uid) ||
        // Case 2: Currently unsupervised -> Ward updates standalone OR new guardian claims guardianship
        (resource.data.get('guardianUid', null) == null && (
          (isOwner(wardUid) && request.resource.data.get('guardianUid', null) == null) ||
          (
            request.resource.data.get('guardianUid', null) == request.auth.uid &&
            request.resource.data.get('pairingCode', null) != null &&
            exists(/databases/$(database)/documents/pairings/$(request.resource.data.pairingCode)) &&
            get(/databases/$(database)/documents/pairings/$(request.resource.data.pairingCode)).data.ownerUid == wardUid &&
            get(/databases/$(database)/documents/pairings/$(request.resource.data.pairingCode)).data.status == 'LOCKED'
          )
        )) ||
        // Case 3: Ward updates policy when supervised and self-control is explicitly allowed by guardian
        (resource.data.get('guardianUid', null) != null && isOwner(wardUid) &&
          resource.data.get('isSelfControlAllowed', false) == true &&
          request.resource.data.get('guardianUid', null) == resource.data.get('guardianUid', null) &&
          request.resource.data.get('isSupervised', null) == resource.data.get('isSupervised', null) &&
          request.resource.data.get('isSelfControlAllowed', false) == resource.data.get('isSelfControlAllowed', false) &&
          request.resource.data.get('selfControlCurfewAllowed', true) == resource.data.get('selfControlCurfewAllowed', true) &&
          request.resource.data.get('selfControlWebAllowed', false) == resource.data.get('selfControlWebAllowed', false) &&
          request.resource.data.get('selfControlAppsAllowed', false) == resource.data.get('selfControlAppsAllowed', false) &&
          request.resource.data.get('selfControlWaqfaAllowed', true) == resource.data.get('selfControlWaqfaAllowed', true) &&
          request.resource.data.get('selfControlPageShieldAllowed', false) == resource.data.get('selfControlPageShieldAllowed', false) &&
          request.resource.data.get('selfControlNewAppsAllowed', false) == resource.data.get('selfControlNewAppsAllowed', false) &&
          request.resource.data.get('isDateTimeLocked', false) == resource.data.get('isDateTimeLocked', false) &&
          request.resource.data.get('isClearAppDataAllowed', true) == resource.data.get('isClearAppDataAllowed', true) &&
          request.resource.data.get('breakoutStatus', null) == resource.data.get('breakoutStatus', null) &&
          request.resource.data.get('breakoutRequestedAt', null) == resource.data.get('breakoutRequestedAt', null) &&
          request.resource.data.get('breakoutUnlockAt', null) == resource.data.get('breakoutUnlockAt', null) &&
          request.resource.data.get('deactivationStatus', null) == resource.data.get('deactivationStatus', null) &&
          request.resource.data.get('deactivationRequestedAt', null) == resource.data.get('deactivationRequestedAt', null) &&
          request.resource.data.get('deactivationUnlockAt', null) == resource.data.get('deactivationUnlockAt', null) &&
          request.resource.data.get('deactivationHasQr', false) == resource.data.get('deactivationHasQr', false) &&
          request.resource.data.get('remoteSelfControlResetRequestedAt', null) == resource.data.get('remoteSelfControlResetRequestedAt', null) &&
          request.resource.data.get('remoteTeardownRequestedAt', null) == resource.data.get('remoteTeardownRequestedAt', null)) ||
        // Case 4: Ward updates heartbeat, sync acknowledgment, and device capabilities while supervised
        (resource.data.get('guardianUid', null) != null && isOwner(wardUid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastHeartbeat', 'acknowledgedVersion', 'lastAcknowledgedAt',
            'wardHasAccessibilityService', 'wardHasUsageStats',
            'wardCanWriteSecureSettings', 'wardCapabilitiesUpdatedAt',
            'wardA11yTamperAt', 'wardSdkInt'
          ])) ||
        // Case 5: Ward initiates or cancels 24h emergency breakout while supervised (protection stays intact)
        (resource.data.get('guardianUid', null) != null && isOwner(wardUid) &&
          request.resource.data.get('guardianUid', null) == resource.data.get('guardianUid', null) &&
          request.resource.data.get('isSupervised', null) == resource.data.get('isSupervised', null) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['breakoutStatus', 'breakoutRequestedAt', 'breakoutUnlockAt', 'updatedAt']) &&
          (
            // Subcase 5a: Initiating breakout -> Must enforce minimum 24 hours (with 15-minute clock drift tolerance)
            (request.resource.data.get('breakoutStatus', null) == 'PENDING' &&
             request.resource.data.get('breakoutUnlockAt', 0) >= request.time.toMillis() + 85500000 &&
             request.resource.data.get('breakoutRequestedAt', 0) <= request.time.toMillis() + 900000) ||
            // Subcase 5b: Cancelling breakout
            (request.resource.data.get('breakoutStatus', null) == 'CANCELLED' &&
             request.resource.data.get('breakoutUnlockAt', null) == null)
          )
        ) ||
        // Case 5c: Ward initiates or cancels Device Owner Deactivation (48h default, 24h with QR)
        // Blocked when a Guardian remote teardown command is already pending.
        (resource.data.get('guardianUid', null) != null && isOwner(wardUid) &&
          resource.data.get('remoteTeardownRequestedAt', null) == null &&
          request.resource.data.get('guardianUid', null) == resource.data.get('guardianUid', null) &&
          request.resource.data.get('isSupervised', null) == resource.data.get('isSupervised', null) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deactivationStatus', 'deactivationRequestedAt', 'deactivationUnlockAt', 'deactivationHasQr', 'updatedAt']) &&
          (
            (request.resource.data.get('deactivationStatus', null) == 'PENDING' &&
             request.resource.data.get('deactivationRequestedAt', 0) <= request.time.toMillis() + 900000 &&
             ((request.resource.data.get('deactivationHasQr', false) == true && request.resource.data.get('deactivationUnlockAt', 0) >= request.time.toMillis() + 85500000) ||
              (request.resource.data.get('deactivationHasQr', false) == false && request.resource.data.get('deactivationUnlockAt', 0) >= request.time.toMillis() + 171900000))) ||
            (request.resource.data.get('deactivationStatus', null) == 'CANCELLED' &&
             request.resource.data.get('deactivationUnlockAt', null) == null)
          )
        ) ||
        // Case 5d: Ward executes Device Owner Deactivation AFTER 48h (or 24h with QR) grace period has passed
        (resource.data.get('guardianUid', null) != null && isOwner(wardUid) &&
          resource.data.get('deactivationStatus', null) == 'PENDING' &&
          resource.data.get('deactivationUnlockAt', 0) > 0 &&
          request.time.toMillis() >= resource.data.get('deactivationUnlockAt', 0) &&
          request.resource.data.get('guardianUid', null) == null &&
          request.resource.data.get('isSupervised', false) == false &&
          request.resource.data.get('deactivationStatus', null) == 'COMPLETED') ||
        // Case 6: Ward executes emergency breakout AFTER 24h grace period has legitimately passed on server clock
        (resource.data.get('guardianUid', null) != null && isOwner(wardUid) &&
          resource.data.get('breakoutStatus', null) == 'PENDING' &&
          resource.data.get('breakoutUnlockAt', 0) > 0 &&
          request.time.toMillis() >= resource.data.get('breakoutUnlockAt', 0) &&
          request.resource.data.get('guardianUid', null) == null &&
          request.resource.data.get('isSupervised', false) == false &&
          request.resource.data.get('breakoutStatus', null) == 'COMPLETED')
      );
      allow delete: if false;
    }

    // 3. Approvals: Zero-trust app installation requests and guardian approvals as subcollection under policies
    match /policies/{wardUid}/approvals/{ticketId} {
      allow read: if isOwner(wardUid) || isGuardianOf(wardUid);
      allow create: if request.auth != null && (
        isGuardianOf(wardUid) ||
        (
          isOwner(wardUid) &&
          request.resource.data.get('packageName', '') == ticketId &&
          request.resource.data.get('wardUid', '') == wardUid &&
          (
            request.resource.data.get('status', '') == 'PENDING' ||
            (
              request.resource.data.get('status', '') == 'APPROVED' &&
              request.resource.data.get('decidedBy', '') == 'SELF' &&
              isSelfAppApprovalAllowed(wardUid, ticketId)
            ) ||
            (
              request.resource.data.get('status', '') == 'REJECTED' &&
              request.resource.data.get('decidedBy', '') == 'SELF' &&
              isSelfAppDecisionAllowed(wardUid)
            )
          )
        )
      );
      allow update: if request.auth != null && (
        isGuardianOf(wardUid) ||
        (
          isOwner(wardUid) &&
          resource.data.get('status', '') == 'PENDING' &&
          request.resource.data.get('decidedBy', '') == 'SELF' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt']) &&
          (
            (
              request.resource.data.get('status', '') == 'APPROVED' &&
              isSelfAppApprovalAllowed(wardUid, ticketId)
            ) ||
            (
              request.resource.data.get('status', '') == 'REJECTED' &&
              isSelfAppDecisionAllowed(wardUid)
            )
          )
        )
      );
      allow delete: if request.auth != null && (
        isGuardianOf(wardUid) ||
        (isOwner(wardUid) && resource.data.get('status', '') != 'REJECTED')
      );
    }

    // Legacy Approvals: Root approvals collection kept for backward compatibility
    match /approvals/{ticketId} {
      allow read: if request.auth != null && (isOwner(resource.data.wardUid) || isGuardianOf(resource.data.wardUid));
      allow create: if request.auth != null && request.resource.data.wardUid == request.auth.uid && request.resource.data.status == 'PENDING';
      allow update: if request.auth != null && request.auth.uid != resource.data.wardUid && isGuardianOf(resource.data.wardUid);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.wardUid || isGuardianOf(resource.data.wardUid));
    }

    // 4. Users: Tokens and partner relationships
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 5. Inventories: App inventory uploaded by ward and inspected/managed by guardian
    match /inventories/{wardUid} {
      allow read: if isOwner(wardUid) || isGuardianOf(wardUid);
      allow create, update: if request.auth != null && request.auth.uid == wardUid;
      allow delete: if false;
    }

    // Short-lived write-only migration authorization tokens written by the old UID prior to switching accounts.
    match /uid_migration_tokens/{uid} {
      allow read: if false;
      allow create, update: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.get('secret', '') is string &&
        request.resource.data.get('secret', '').size() >= 32 &&
        request.resource.data.get('expiresAt', 0) > request.time.toMillis() &&
        request.resource.data.get('expiresAt', 0) <= request.time.toMillis() + 600000;
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        (
          exists(/databases/$(database)/documents/uid_mappings/$(uid)) &&
          get(/databases/$(database)/documents/uid_mappings/$(uid)).data.get('activeUid', '') == request.auth.uid
        )
      );
    }

    // UID Mappings: Forwarding aliases for accounts that upgraded from device fallback or changed UID.
    // Prevents third-party hijacking of guardianUid aliases via unauthenticated/unverified writes.
    match /uid_mappings/{oldUid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        request.auth.uid == oldUid ||
        (
          request.resource.data.get('activeUid', '') == request.auth.uid &&
          (
            (
              exists(/databases/$(database)/documents/uid_mappings/$(oldUid)) &&
              resource.data.get('activeUid', '') == request.auth.uid
            ) ||
            (
              !exists(/databases/$(database)/documents/uid_mappings/$(oldUid)) &&
              exists(/databases/$(database)/documents/uid_migration_tokens/$(oldUid)) &&
              get(/databases/$(database)/documents/uid_migration_tokens/$(oldUid)).data.get('secret', '') != '' &&
              get(/databases/$(database)/documents/uid_migration_tokens/$(oldUid)).data.get('expiresAt', 0) >= request.time.toMillis() &&
              request.resource.data.get('migrationSecret', '') == get(/databases/$(database)/documents/uid_migration_tokens/$(oldUid)).data.get('secret', '')
            )
          )
        )
      );
      allow delete: if request.auth != null && (
        request.auth.uid == oldUid ||
        (
          exists(/databases/$(database)/documents/uid_mappings/$(oldUid)) &&
          resource.data.get('activeUid', '') == request.auth.uid
        )
      );
    }
  }
}

