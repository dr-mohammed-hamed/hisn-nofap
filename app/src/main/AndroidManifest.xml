<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Package visibility queries for Android 11+ (API 30+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AntiPornApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Antiporn"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Antiporn.Starting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AdminReceiver"
            android:description="@string/app_name"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />

            </intent-filter>
        </receiver>

        <!-- Android Enterprise Provisioning Handlers (Android 10+ / API 29+) -->
        <activity
            android:name=".provisioning.ui.EnterpriseProvisioningActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@style/Theme.Antiporn"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.PROVISIONING_SUCCESSFUL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".provisioning.ui.SystemAppsManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.Antiporn"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".waqfa.ui.gate.WaqfaGateActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:theme="@style/Theme.Antiporn"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <activity
            android:name=".waqfa.ui.settings.WaqfaSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Antiporn"
            android:screenOrientation="portrait" />

        <activity
            android:name=".pageshield.ui.PageShieldSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Antiporn"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".PackageChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.drmohammed.antiporn.ACTION_UNINSTALL_STATUS" />

            </intent-filter>
        </receiver>

        <receiver
            android:name=".curfew.CurfewAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.drmohammed.antiporn.ACTION_CURFEW_START" />
                <action android:name="com.drmohammed.antiporn.ACTION_CURFEW_END" />
                <action android:name="com.drmohammed.antiporn.ACTION_FORTRESS_END" />
                <action android:name="com.drmohammed.antiporn.ACTION_NAP_END" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".waqfa.engine.WaqfaAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.drmohammed.antiporn.waqfa.ACTION_SESSION_TIMEOUT" />
                <action android:name="com.drmohammed.antiporn.waqfa.ACTION_COOLDOWN_EXPIRED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".pageshield.engine.PageShieldAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.drmohammed.antiporn.ACTION_PAGE_SHIELD_UNFREEZE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".curfew.CurfewBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.QUICKBOOT_POWEROFF" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".fortress.notification.FortressNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.drmohammed.antiporn.fortress.ACTION_EXTEND_FORTRESS" />
            </intent-filter>
        </receiver>

        <!-- Official Android Enterprise Device Admin Service (API 26+) for zero-notification persistent foreground binding -->
        <service
            android:name=".HisnDeviceAdminService"
            android:enabled="@bool/enable_device_admin_service"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            tools:targetApi="o">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".DnsWatchdogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforce enterprise DNS security and prevent private DNS tampering on Device Owner managed hardware" />
        </service>

        <service
            android:name=".curfew.CurfewBlackholeVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforce complete network isolation and prevent internet access during curfew on Device Owner managed hardware" />
        </service>

        <service
            android:name=".ai.service.ScreenAiProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".cloud.fcm.AntiPornFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".ui.accountability.GuardianControlActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_guardian_control" />
        <activity
            android:name=".ui.accountability.GuardianSelfControlSettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/guardian_self_control_settings_title" />
        <activity
            android:name=".ui.accountability.GuardianApprovalsHubActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/title_approvals_hub" />
        <activity
            android:name=".ui.accountability.RemoteAppManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.control.curfew.CurfewSettingsActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".fortress.ui.FortressesListActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".fortress.ui.FortressEditorActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.control.web.WebFilterSettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.control.web.LocalDnsFallbackConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Antiporn.TranslucentDialog" />
        <activity
            android:name=".ui.control.other.OtherSettingsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.settings.DiagnosticLogViewerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/title_log_viewer" />

        <!-- Device Owner In-App Provisioning -->
        <activity
            android:name=".provisioning.ui.ProvisioningWizardActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:label="@string/provisioning_wizard_title" />

        <!-- In-App Notification Center -->
        <activity
            android:name=".ui.notification.NotificationCenterActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/title_notification_center" />

        <!-- Waqf Support (Sadaqah Jariyah) -->
        <activity
            android:name=".ui.waqf.WaqfSupportActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/waqf_support_title" />

        <service
            android:name=".provisioning.service.AdbPairingNotificationService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Device Owner local pairing and setup" />
        </service>

        <receiver
            android:name=".provisioning.receiver.PairingCodeReceiver"
            android:exported="false" />

        <receiver
            android:name=".ota.receiver.OtaInstallReceiver"
            android:exported="false" />

        <!-- Banking Cloak Engine for InstaPay -->
        <activity
            android:name=".banking.SafeBankingLauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/banking_shortcut_long_label" />

        <receiver
            android:name=".banking.BankingRestoreReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable default WorkManagerInitializer so we can initialize on-demand with KoinWorkerFactory -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Hisn Central Accessibility Service for 0ms Waqfa Interception -->
        <service
            android:name=".accessibility.HisnAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hisn_accessibility_config" />
        </service>
    </application>

</manifest>
