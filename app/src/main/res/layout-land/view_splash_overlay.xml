<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg_dark"
    android:clickable="true"
    android:focusable="true">

    <!-- Center Content: Horizontal Glow + Shield on Start, Typography on End -->
    <LinearLayout
        android:id="@+id/splashContentGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/ivSplashGlow"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:alpha="0.8"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/bg_splash_emerald_glow" />

            <ImageView
                android:id="@+id/ivSplashShield"
                android:layout_width="104dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hisn_shield_emblem" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:gravity="start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSplashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tajawal"
                android:letterSpacing="0.04"
                android:text="@string/splash_title"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSplashSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/tajawal"
                android:letterSpacing="0.03"
                android:text="@string/splash_subtitle"
                android:textColor="@color/splash_subtitle"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
