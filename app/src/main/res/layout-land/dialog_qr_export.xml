<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <!-- Compact Header -->
        <TextView
            android:id="@+id/tvExportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal"
            android:gravity="center"
            android:text="@string/qr_export_dialog_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExportSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/tajawal"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/qr_export_dialog_subtitle"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12.5sp" />

        <!-- Dual-Column Split: 170dp QR Card on Start, Actions & Confirmation on End -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Start: QR Code Card -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    app:cardBackgroundColor="#FFFFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/ivExportQrCode"
                        android:layout_width="154dp"
                        android:layout_height="154dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/qr_export_dialog_title"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/ic_hisn_shield_emblem" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- End: Warning + Export Buttons + Checkbox + Activate + Close -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/cardExportWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_qr_card_warning"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning_amber"
                        app:tint="@color/shield_amber_calm" />

                    <TextView
                        android:id="@+id/tvExportWarning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/tajawal"
                        android:text="@string/qr_export_warning"
                        android:textColor="@color/shield_amber_calm"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareQr"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/tajawal"
                    android:text="@string/qr_export_share"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrintQr"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/tajawal"
                        android:text="@string/qr_export_print"
                        android:textSize="12.5sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_print"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveQrImage"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/tajawal"
                        android:text="@string/qr_export_save"
                        android:textSize="12.5sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_save"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />
                </LinearLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbAcknowledgePossession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/tajawal"
                    android:text="@string/qr_wizard_acknowledge_checkbox"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProceedTestScan"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:fontFamily="@font/tajawal"
                        android:text="@string/qr_wizard_btn_activate_lock"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_verified"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="?attr/colorOnPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloseExportDialog"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:fontFamily="@font/tajawal"
                        android:text="@string/qr_export_close"
                        android:textColor="?attr/colorOutline"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
