<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Intro Explanation -->
        <TextView
            android:id="@+id/tvBlockingIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/tajawal"
            android:lineHeight="20sp"
            android:text="@string/provisioning_blocking_dialog_intro"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            tools:targetApi="p" />

        <!-- Dynamic List of Detected Blocking Profiles/Users -->
        <LinearLayout
            android:id="@+id/layoutBlockingUsersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical" />

        <!-- Irreversible Warning + Explicit Consent Box -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/status_red_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/status_red"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvBlockingIrreversibleWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/tajawal"
                    android:lineHeight="19sp"
                    android:text="@string/provisioning_blocking_irreversible_warning"
                    android:textColor="@color/status_red"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:targetApi="p" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chkBlockingConsent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:checked="false"
                    android:fontFamily="@font/tajawal"
                    android:text="@string/provisioning_blocking_consent_checkbox"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Open Settings to Back Up Data First -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenBlockingSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/tajawal"
            android:minHeight="48dp"
            android:text="@string/provisioning_blocking_btn_open_settings"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

        <!-- Confirm Delete & Activate (Disabled until 5s countdown finishes AND checkbox checked) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmRemoveAndActivate"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:enabled="false"
            android:fontFamily="@font/tajawal"
            android:minHeight="48dp"
            android:text="@string/provisioning_blocking_btn_confirm_ready"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Cancel Without Deleting -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelBlockingUsers"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal"
            android:minHeight="48dp"
            android:text="@string/provisioning_blocking_btn_cancel"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
