<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Warning / Alert Icon Badge -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_shield_status_badge_red">

            <ImageView
                android:id="@+id/ivDangerIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@string/dialog_danger_private_space_title"
                android:src="@drawable/ic_warning_24"
                app:tint="@color/status_red" />
        </FrameLayout>

        <!-- Danger Modal Title -->
        <TextView
            android:id="@+id/tvDangerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/tajawal"
            android:gravity="center"
            android:text="@string/dialog_danger_private_space_title"
            android:textColor="@color/status_red"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Warning Description -->
        <TextView
            android:id="@+id/tvDangerDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/tajawal"
            android:lineHeight="20sp"
            android:text="@string/dialog_danger_private_space_desc"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            tools:targetApi="p" />

        <!-- Acknowledgment Checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkAcknowledgeDanger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/tajawal"
            android:text="@string/dialog_danger_private_space_checkbox"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <!-- Action Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Re-check Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogRecheck"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="48dp"
                android:fontFamily="@font/tajawal"
                android:text="@string/dialog_danger_private_space_btn_recheck"
                android:textSize="14sp"
                app:cornerRadius="12dp" />

            <!-- Proceed at Own Risk Button (Contained with Error/Danger Background Tint, Disabled by Default) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogProceed"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:minHeight="48dp"
                android:enabled="false"
                android:fontFamily="@font/tajawal"
                android:text="@string/dialog_danger_private_space_btn_proceed"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/status_red"
                app:cornerRadius="12dp" />

            <!-- Cancel / Dismiss Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:fontFamily="@font/tajawal"
                android:text="@android:string/cancel"
                android:textColor="?attr/colorOutline"
                android:textSize="13sp"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
