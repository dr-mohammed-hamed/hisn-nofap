<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardChannel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header Row: Icon + Badge + Title + Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/frameChannelIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_shield_icon_circle">

                <ImageView
                    android:id="@+id/ivChannelIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    tools:src="@drawable/ic_bank" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvChannelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/tajawal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="إنستاباي"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvChannelTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tajawal"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="InstaPay" />

                <TextView
                    android:id="@+id/tvChannelSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/tajawal"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="تحويل فوري بدون رسوم"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Copyable LTR Display Value Box (for numbers, handles, IBAN) -->
        <LinearLayout
            android:id="@+id/layoutDisplayValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="11dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvDisplayValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorOnSurface"
                android:textDirection="ltr"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="mh22887565" />

            <ImageView
                android:id="@+id/ivCopyHint"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/waqf_tap_to_copy_hint"
                android:src="@drawable/ic_copy"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Optional Instructions -->
        <TextView
            android:id="@+id/tvChannelInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/tajawal"
            android:lineSpacingMultiplier="1.2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="يتم فتح تطبيق إنستاباي بأمان مع تفعيل وضع التخفي البنكي تلقائياً."
            tools:visibility="visible" />

        <!-- Primary & Secondary Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutChannelActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimaryAction"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/tajawal"
                android:maxLines="1"
                android:minHeight="46dp"
                android:paddingHorizontal="12dp"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                tools:icon="@drawable/ic_open_in_new"
                tools:text="InstaPay" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSecondaryAction"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/tajawal"
                android:maxLines="1"
                android:minHeight="46dp"
                android:paddingHorizontal="12dp"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                tools:icon="@drawable/ic_copy"
                tools:text="نسخ المعرف" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
