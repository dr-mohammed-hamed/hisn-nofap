<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvUserCategoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/tajawal"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="المجلد الآمن (Secure Folder) — رقم 150" />

        <TextView
            android:id="@+id/tvUserAffectedApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/tajawal"
            android:lineHeight="18sp"
            android:textColor="@color/status_red"
            android:textSize="13sp"
            tools:targetApi="p"
            tools:text="التطبيقات المتأثرة: واتساب، تيليجرام" />

        <TextView
            android:id="@+id/tvUserCategoryNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal"
            android:lineHeight="18sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:targetApi="p"
            tools:text="حذفه يزيل المجلد الآمن ومحتوياته فقط ولا يمس ملفاتك خارج المجلد." />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
