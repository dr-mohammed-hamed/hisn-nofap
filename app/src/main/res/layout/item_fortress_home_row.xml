<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Hisn.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/hisn_card_gap"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="@dimen/hisn_card_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/hisn_card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_shield_icon_circle">

                <ImageView
                    android:id="@+id/ivFortressIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    tools:src="@drawable/ic_shield_time" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFortressTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tajawal"
                    android:textAlignment="viewStart"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="حصن المذاكرة" />

                <TextView
                    android:id="@+id/tvFortressDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/tajawal"
                    android:textAlignment="viewStart"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="60 دقيقة · إنترنت مقطوع" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFortressBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_shield_status_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorSuccess"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="نشط" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFortressStart"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hisn_card_gap"
            android:minHeight="@dimen/hisn_control_height"
            android:textAlignment="viewStart"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            tools:text="تشغيل (60 د)" />

        <LinearLayout
            android:id="@+id/layoutFortressActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hisn_card_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFortressCountdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_active_shields_pill"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textColor="?attr/colorSuccess"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="المتبقي: 59:45" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFortressExtend"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="@dimen/hisn_control_height"
                android:textAlignment="viewStart"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                tools:text="تمديد" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
